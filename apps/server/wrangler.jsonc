{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "deskbeacon",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-17",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "observability": {
    "enabled": false
  },
  "vars": {
    "MCP_BASE_URL": ""
  },
  "kv_namespaces": [
    {
      "binding": "OAUTH_KV",
      "id": "a84b7df46fa742ba902b5fc6d951890f"
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "DEVICE_SESSIONS",
        "class_name": "DeviceSession"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": [
        "DeviceSession"
      ]
    }
  ]
}
